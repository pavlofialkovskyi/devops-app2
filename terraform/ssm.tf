resource "random_password" "jwt_secret" { # generates a random password JWT secret
  length  = 64
  special = false # letters and numbers only, to avoid symbols typing in bash command
}

resource "aws_ssm_parameter" "jwt_secret" {
  name  = "/devops-app2/jwt_secret"
  type  = "SecureString"                    # encrypted
  value = random_password.jwt_secret.result # passes the JWT Secret to parameter store 
}

# but besides that we are moving the db_password generation and storing it in the parameter store from rds.tf


resource "random_password" "db_password" {
  length  = 20
  special = false
}


# this is the way we store the Postgres DB password to forward to our EC2 instance web app, so the app has the KEY
# this password is also stored in the resource "aws_db_instance" "main" so the DB has the LOCK to be opened by web's KEY (the KEY will be stored in the IAM.tf role/policy)
resource "aws_ssm_parameter" "db_password" {
  name  = "/devops-app2/db_password"
  type  = "SecureString"
  value = random_password.db_password.result
}

# also the db_host was not stored in the parameter store, it is the arn long name that is generated by terraform every time
# terraform builds the architecture, despite the S3 buckets that have their name defined in the code, the Postgres DB name is autogenerated every build 

resource "aws_ssm_parameter" "db_host" {
  name  = "/devops-app2/db_host"
  type  = "String"
  value = aws_db_instance.main.address
}